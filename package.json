  "description": "A simple scene using Babylon.js, typescript and webpack. What could go wrong?",
  "main": "index.ts",
  "dependencies": {
    "@babylonjs/assets": "^5.20.0",
    "@babylonjs/core": "^9.20.0",
    "@babylonjs/gui-editor": "^9.20.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/inspector": "^9.20.0",
    "@babylonjs/loaders": "^9.20.0",
    "@babylonjs/materials": "^9.20.0",
    "ammo.js": "github:kripken/ammo.js#0f92865b2f2cff3602ff2cf203101cde0edf2c37",
    "recast-detour": "^1.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "clean-webpack-plugin": "^4.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.4.2",
    "source-map-loader": "^5.0.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-shader-loader": "^2.1.0",
    "typescript": "^6.0.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "scripts": {
    "start": "webpack serve",
    "start:test": "webpack serve --env test",
    "build": "webpack --env production",
    "build:dev": "webpack",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:visuals": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test:unit"
