{
  "name": "babylonjs-typescript-webpack-template",
  "version": "0.0.1",
  "private": true,
  "description": "A Babylon.js starter using strict TypeScript and webpack.",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "dependencies": {
    "@babylonjs/core": "^9.26.1",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.26.1",
    "@babylonjs/materials": "^9.26.1",
    "ammo.js": "github:kripken/ammo.js#0f92865b2f2cff3602ff2cf203101cde0edf2c37",
    "recast-detour": "^1.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.6.2",
    "ts-shader-loader": "^2.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "scripts": {
    "start": "webpack serve",
    "start:test": "webpack serve --env test",
    "build": "webpack --env production",
    "build:demo": "webpack --env production --env demo",
    "build:dev": "webpack",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:visuals": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test:unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaananW/babylonjs-webpack-es6.git"
  },
  "keywords": [
    "Babylon.js",
    "webpack",
    "getting started",
    "typescript",
    "es6"
  ],
  "author": {
    "name": "Raanan Weber",
    "email": "info@raananweber.com",
    "url": "http://blog.raananweber.com/"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/RaananW/babylonjs-webpack-es6/issues"
  },
  "homepage": "https://github.com/RaananW/babylonjs-webpack-es6"
}
